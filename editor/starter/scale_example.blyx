use vendor::linearfit::bilinear;

fn main() {
    let left = [1,0,0,1];
    let right = [1,0,0,1];
    let gram = lf_pair_gram(left,right,2);
    let alpha = lf_pair_fit(gram,[1,-1],[0,0],1,1.0);
    println!(lf_pair_predict(left,right,alpha,[2,3],[1,1]));
    println!(lf_pair_weight(left,right,alpha,1,1));
}
